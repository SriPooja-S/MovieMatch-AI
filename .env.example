# MovieMatch AI - Environment Configuration Template
# Copy this file to .env and insert your API keys

# TMDB API Configuration
# Get your free key from: https://www.themoviedb.org/settings/api
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_API_KEY=your_api_key_here

# Application Settings
DATA_DIR=app/data

# Embedding Model Configuration
# Options: all-MiniLM-L6-v2, paraphrase-multilingual-mpnet-base-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Search Settings
TOP_K_RESULTS=10
MIN_SIMILARITY_SCORE=0.0

# CLIP Model for Image/Video Processing
# Options: ViT-B/32, ViT-B/16, ViT-L/14
CLIP_MODEL=ViT-B/32

# Ingestion Settings
TMDB_PAGES_PER_ENDPOINT=10
FETCH_TIMEOUT=30
MAX_RETRIES=5
BATCH_SIZE=100

# Video & Image Processing
MAX_VIDEO_SIZE_MB=50
DEFAULT_FRAME_EXTRACTION=10
VIDEO_DOWNLOAD_DIR=temp_downloads
MAX_IMAGE_SIZE_MB=10
ENABLE_OCR=true
OCR_LANGUAGE=eng

# Hardware & Performance
USE_GPU=auto
CACHE_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log
